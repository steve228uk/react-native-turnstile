{
  "name": "@steve228uk/react-native-turnstile",
  "version": "0.1.0",
  "description": "Cloudflare Turnstile for React Native and Expo, powered by react-native-webview.",
  "keywords": [
    "react-native",
    "expo",
    "cloudflare",
    "turnstile",
    "captcha",
    "webview"
  ],
  "homepage": "https://github.com/steve228uk/react-native-turnstile#readme",
  "bugs": {
    "url": "https://github.com/steve228uk/react-native-turnstile/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steve228uk/react-native-turnstile.git"
  },
  "license": "MIT",
  "author": "Stephen Radford",
  "type": "module",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./lib/typescript/index.d.ts",
      "import": "./lib/module/index.js",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "example"
  ],
  "scripts": {
    "build": "bob build",
    "clean": "bob clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "pack:check": "npm pack --dry-run",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun run test:coverage && bun run build && bun run publint && bun run attw && bun run pack:check",
    "prepare": "bob build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.76",
    "react-native-webview": ">=13.12"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^7.28.4",
    "@babel/runtime": "^7.29.2",
    "@eslint/js": "^9.39.1",
    "@react-native/babel-preset": "^0.86.2",
    "@react-native/jest-preset": "^0.86.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.17",
    "babel-jest": "^29.7.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.0",
    "publint": "^0.3.22",
    "react": "^19.2.8",
    "react-native": "^0.86.2",
    "react-native-builder-bob": "^0.43.0",
    "react-native-webview": "^14.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
