# Public app configuration. Use your computer's LAN IP instead of 127.0.0.1
# when opening the harness on a physical device.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
EXPO_PUBLIC_TURNSTILE_BASE_URL=https://localhost
EXPO_PUBLIC_SITEVERIFY_URL=http://127.0.0.1:8787/siteverify

# Server-only configuration. Never prefix this variable with EXPO_PUBLIC_.
# This is Cloudflare's deterministic always-pass test secret, for local use only.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Required server-owned expectations. Do not take these values from the app.
TURNSTILE_EXPECTED_HOSTNAME=localhost
TURNSTILE_EXPECTED_ACTION=harness-submit
# Use 0.0.0.0 only when testing from a physical device on a trusted network.
SITEVERIFY_HOST=127.0.0.1
SITEVERIFY_PORT=8787
TURNSTILE_ALLOWED_ORIGIN=*

# To demonstrate duplicate-token rejection, temporarily use Cloudflare's
# deterministic "token already spent" test secret, restart the server, and
# submit a token from a passing visible/invisible sitekey:
# TURNSTILE_SECRET_KEY=3x0000000000000000000000000000000AA
